+/// Cargo builds every crate type of a target in one rustc invocation; a derivation
+/// produces one. Dependents only ever link the rlib, so prefer `lib`/`rlib` (as `lib`),
+/// then `proc-macro`, else the single declared type.
+fn pick_crate_type(unit: &Unit) -> eyre::Result<&str> {
+    let types = &unit.target.crate_types;
+    if types.iter().any(|t| t == "lib" || t == "rlib") {
+        return Ok("lib");
+    }
+    if types.iter().any(|t| t == "proc-macro") {
+        return Ok("proc-macro");
+    }
+    match types.as_slice() {
+        [single] => Ok(single.as_str()),
+        _ => eyre::bail!(
+            "unit {} has unexpected crate types, {:?}",
+            unit.pkg_id,
+            types
+        ),
+    }
+}
